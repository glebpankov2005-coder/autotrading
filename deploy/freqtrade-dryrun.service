# systemd service: Apex dry-run, auto-restart + start on boot.
# Install:
#   sudo cp deploy/freqtrade-dryrun.service /etc/systemd/system/
#   (edit User= and the two /opt/apex-trading-bot paths to match your install)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now freqtrade-dryrun
#   journalctl -u freqtrade-dryrun -f      # live logs
[Unit]
Description=Freqtrade dry-run (Apex)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freqtrade
WorkingDirectory=/opt/apex-trading-bot
ExecStart=/opt/apex-trading-bot/.venv/bin/freqtrade trade --config user_data/config_dryrun.json
Restart=always
RestartSec=15
# keep logs bounded via journald; rotate the sqlite DB backups separately
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
